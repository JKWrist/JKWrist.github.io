---
layout: null
---
[
  {% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "category": {{ post.categories.first | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | truncate: 200 | jsonify }},
    "date": "{{ post.date | date: '%Y-%m-%d' }}"
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% if site.wiki.size > 0 %},{% endif %}
  {% for wiki in site.wiki %}
  {
    "title": {{ wiki.title | jsonify }},
    "url": {{ wiki.url | relative_url | jsonify }},
    "category": "Wiki",
    "content": {{ wiki.content | strip_html | strip_newlines | truncate: 200 | jsonify }},
    "date": ""
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
